APP_NAME=SpeedService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=speedservice
DB_USERNAME=speedservice
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@speedservice.bj
MAIL_FROM_NAME="Speed Service"

# Utiliser "http" en production une fois la passerelle SMS configurée.
SMS_DRIVER=log
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=SpeedService

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_PREFIX=

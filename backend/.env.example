APP_NAME=SpeedService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.speedservice.bj
FRONTEND_URL=https://speedservice.bj

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=speedservice
DB_USERNAME=speedservice
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Utilisées par le service `db` du docker-compose (init du volume Postgres) —
# doivent rester alignées avec DB_DATABASE / DB_USERNAME / DB_PASSWORD
POSTGRES_DB=speedservice
POSTGRES_USER=speedservice
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM_ADDRESS=noreply@speedservice.bj
MAIL_FROM_NAME="Speed Service"
ADMIN_NOTIFICATION_EMAIL=zelofane33@gmail.com

# Passer SMS_DRIVER=http une fois la passerelle SMS configurée.
SMS_DRIVER=log
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=SpeedService

# Cloudinary — stockage des images et documents (pièces livreur en mode privé).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_FOLDER=speedservice
# Durée (secondes) de validité des liens de téléchargement signés des documents.
CLOUDINARY_SIGNED_URL_TTL=300

SANCTUM_STATEFUL_DOMAINS=speedservice.bj,admin.speedservice.bj,driver.speedservice.bj
SANCTUM_TOKEN_PREFIX=
